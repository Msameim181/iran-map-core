      ],
      "counties-standard": [
        "dist/types/counties-standard.d.ts"
      ],
      "geography-standard": [
        "dist/types/geography-standard.d.ts"
      ],
      "standard": [
        "dist/types/standard.d.ts"
      ],
      "provinces-lite": [
