  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "npm run clean && vite build && npm run build:types && npm run build:styles",
    "build:types": "tsc -p tsconfig.build.json && node scripts/build-types.js",
    "build:styles": "node scripts/copy-styles.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "check:package": "publint run --pack npm --strict && attw --pack . --profile node16 --exclude-entrypoints ./styles.css ./iran-map.css ./score-bands.css",
    "smoke": "node scripts/smoke-runtime.mjs && node scripts/smoke-types.mjs",
    "check:size": "node scripts/check-size.mjs",
    "build:compare": "node scripts/build-lite-compare.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
