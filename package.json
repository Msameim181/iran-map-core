      ],
      "lite": [
        "dist/types/lite.d.ts"
      ],
      "provinces-mini": [
        "dist/types/provinces-mini.d.ts"
      ],
      "counties-mini": [
        "dist/types/counties-mini.d.ts"
      ],
      "geography-mini": [
        "dist/types/geography-mini.d.ts"
      ],
      "mini": [
        "dist/types/mini.d.ts"
      ],
      "lean": [
        "dist/types/lean.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
