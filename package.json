{
  "name": "@msameim181/iran-map-core",
  "version": "0.2.2",
  "description": "Framework-free TypeScript data and logic for Iran SVG maps: provinces, counties, capitals, Persian names, selection and colors",
  "keywords": [
    "iran",
    "iran-map",
    "persian",
    "farsi",
    "svg-map",
    "svg",
    "geojson",
    "provinces",
    "counties",
    "capitals",
    "choropleth",
    "map",
    "typescript",
    "framework-free",
    "map-data",
    "ssr"
  ],
  "author": "Sima Mojtahedi",
  "license": "MIT",
  "homepage": "https://github.com/Msameim181/iran-map-core#readme",
  "bugs": {
    "url": "https://github.com/Msameim181/iran-map-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Msameim181/iran-map-core.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
